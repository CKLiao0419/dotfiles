#!/bin/sh
# lf 預覽腳本：$1=檔案 $2=寬 $3=高 $4=x $5=y
# 回傳非 0 代表「不要快取這次的預覽」，圖片一定要這樣，lf 才會在切換時呼叫 cleaner

file=$1 w=$2 h=$3 x=$4 y=$5

has() { command -v "$1" >/dev/null 2>&1; }

preview_image() {
    # 0. ueberzugpp（Linux X11 + alacritty / st 這類不支援圖片協定的終端）
    #    由 lfcd（fish 的 Ctrl-O）啟動 ueberzugpp 並設定 UB_SOCKET
    if [ -n "${UB_SOCKET:-}" ] && has ueberzugpp; then
        ueberzugpp cmd -s "$UB_SOCKET" -a add -i PREVIEW -x "$x" -y "$y" \
            --max-width "$w" --max-height "$h" -f "$1"
        exit 1
    fi
    # 1. kitty 本體（不在 tmux 裡）：用 kitty 圖片協定畫真正的圖
    if [ -n "$KITTY_WINDOW_ID" ] && [ -z "$TMUX" ] && has kitten; then
        kitten icat --stdin=no --transfer-mode=memory \
            --place "${w}x${h}@${x}x${y}" "$1" </dev/null >/dev/tty
        exit 1
    fi
    # 2. 其他任何地方（tmux 裡、st、xterm、TTY）：chafa 用字元方塊畫
    if has chafa; then
        chafa --format=symbols --size="${w}x${h}" --animate=off "$1"
        exit 1
    fi
    # 3. 什麼都沒有
    echo "[圖片] $(file -b "$1")"
}

text() {
    if has bat; then
        bat --color=always --style=numbers --paging=never \
            --terminal-width="$w" --line-range=:300 "$1"
    elif has batcat; then
        batcat --color=always --style=numbers --paging=never \
            --terminal-width="$w" --line-range=:300 "$1"
    else
        head -n 300 "$1"
    fi
}

mime=$(file --mime-type -Lb "$file")

case "$mime" in
    image/svg*) text "$file" ;;
    image/*) preview_image "$file" ;;
    text/* | application/json | application/javascript | application/x-shellscript \
        | application/toml | application/x-ndjson | application/xml | inode/x-empty)
        text "$file" ;;
    application/zip) unzip -l "$file" ;;
    application/gzip | application/x-tar | application/x-xz | application/x-bzip2)
        tar tf "$file" 2>/dev/null | head -n 200 ;;
    application/pdf)
        if has pdftotext; then pdftotext -l 3 "$file" - | head -n 200
        else file -b "$file"; fi ;;
    video/* | audio/*)
        if has mediainfo; then mediainfo "$file"; else file -b "$file"; fi ;;
    *) file -b "$file" ;;
esac
